[Unit]
Description=HelpdeskPro
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/helpdesk-pro
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/opt/helpdesk-pro/.env

[Install]
WantedBy=multi-user.target
PORT=3000
NODE_ENV=production

# JWT Secret — ตั้งให้ปลอดภัยก่อนรันจริง (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ถ้าเป็น value เดิม (change-this-to-a-long-random-string) เซิร์ฟเวอร์จะไม่ยอม boot
JWT_SECRET=

# LINE Messaging API (ตั้งค่าใน LINE Developers Console)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_GROUP_CHAT_ID=

# Telegram — ตั้งจากหน้าแอดมินในเว็บได้เลย (ไม่ต้องแก้ไฟล์นี้)
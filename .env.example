PORT=3000
NODE_ENV=production

# JWT Secret (เปลี่ยนเป็น string ยาวๆ ที่สุ่มก่อนเปิดใช้)
JWT_SECRET=change-this-to-a-long-random-string

# LINE Messaging API (ตั้งค่าใน LINE Developers Console)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_GROUP_CHAT_ID=

# Telegram — ตั้งจากหน้าแอดมินในเว็บได้เลย (ไม่ต้องแก้ไฟล์นี้)